# PostgreSQL database connection
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# Direct PostgreSQL connection for Prisma migrations
DIRECT_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# JWT authentication secret
JWT_SECRET="replace_with_a_long_random_secret"

# Backend server port
PORT=4000

# Razorpay payment gateway (test credentials)
RAZORPAY_KEY_ID="your_razorpay_test_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_test_key_secret"

# Optional demo product seeding configuration
DEMO_VENDOR_ID="your_demo_vendor_id"
DEMO_VENDOR_STORE="MarketHub Demo Store"

# Optional Unsplash image update scripts
UNSPLASH_ACCESS_KEY="your_unsplash_access_key"